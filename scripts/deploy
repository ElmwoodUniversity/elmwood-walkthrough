#!/usr/bin/env bash

set -e

DIST="$(pwd)/dist"
PAGES_REPO="/mnt/ymir/development/code/adult/spednsfw.github.io"
SOURCE_COMMIT=$(git rev-parse --short HEAD)

rsync -a --delete "$DIST"/ "$PAGES_REPO"/ \
    --exclude='.git'

cd "$PAGES_REPO"

git add -A

if git diff --cached --quiet; then
    echo "No deployment changes."
    exit 0
fi

git commit -m "Deploy build from $SOURCE_COMMIT"
git push
